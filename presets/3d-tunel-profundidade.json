{
  "id": "3d-tunel-profundidade",
  "name": "Túnel de Profundidade",
  "category": "Câmera 3D",
  "description": "A câmera atravessa um túnel e cada palavra entra em foco (depth of field).",
  "style": "depth-tunnel",
  "fps": 30,
