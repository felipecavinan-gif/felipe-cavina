{
  "id": "typewriter-clean",
  "name": "Máquina de Escrever",
  "category": "Tipografia animada",
  "description": "Digitação limpa, centralizada.",
  "style": "typewriter",
  "fps": 30,
  "durationInFrames": 120,
  "formats": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "fields": [
    {
      "key": "prompt",
      "label": "Texto acima (opcional)",
      "type": "text",
      "default": ""
    },
    {
      "key": "text",
      "label": "Texto",
      "type": "textarea",
      "default": "Você já se perguntou por quê?"
    },
    {
      "key": "font",
      "label": "Fonte",
      "type": "font",
      "default": "playfair",
      "options": [
        {
          "value": "inter",
          "label": "Inter"
        },
        {
          "value": "montserrat",
          "label": "Montserrat"
        },
        {
          "value": "poppins",
          "label": "Poppins"
        },
        {
          "value": "bebas",
          "label": "Bebas Neue"
        },
        {
          "value": "playfair",
          "label": "Playfair Display"
        },
        {
          "value": "spacegrotesk",
          "label": "Space Grotesk"
        },
        {
          "value": "jetbrains",
          "label": "JetBrains Mono"
        }
      ]
    },
    {
      "key": "fontSize",
      "label": "Tamanho",
      "type": "number",
      "default": 90,
      "min": 30,
      "max": 200,
      "step": 1
    },
    {
      "key": "speed",
      "label": "Velocidade (caracteres/frame)",
      "type": "number",
      "default": 1,
      "min": 0.2,
      "max": 5,
      "step": 0.1
    },
    {
      "key": "textColor",
      "label": "Cor do texto",
      "type": "color",
      "default": "#111111"
    },
    {
      "key": "accentColor",
      "label": "Cor do cursor",
      "type": "color",
      "default": "#ff3d5a"
    },
    {
      "key": "align",
      "label": "Alinhamento",
      "type": "select",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Esquerda"
        },
        {
          "value": "center",
          "label": "Centro"
        }
      ]
    },
    {
      "key": "bgColor",
      "label": "Cor de fundo",
      "type": "color",
      "default": "#f4f1ea"
    },
    {
      "key": "transparent",
      "label": "Fundo transparente",
      "type": "toggle",
      "default": false,
      "help": "Exporte em MOV/WebM para manter a transparência"
    }
  ]
}
