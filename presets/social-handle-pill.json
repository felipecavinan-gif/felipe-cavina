{
  "id": "social-handle-pill",
  "name": "@ da Rede Social",
  "category": "CTA / Redes sociais",
  "description": "Pílula com ícone e @ da rede.",
  "style": "social-handle",
  "fps": 30,
  "durationInFrames": 120,
  "formats": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "fields": [
    {
      "key": "platform",
      "label": "Rede",
      "type": "select",
      "default": "instagram",
      "options": [
        {
          "value": "instagram",
          "label": "Instagram"
        },
        {
          "value": "youtube",
          "label": "YouTube"
        },
        {
          "value": "tiktok",
          "label": "TikTok"
        },
        {
          "value": "x",
          "label": "X / Twitter"
        },
        {
          "value": "linkedin",
          "label": "LinkedIn"
        },
        {
          "value": "twitch",
          "label": "Twitch"
        }
      ]
    },
    {
      "key": "handle",
      "label": "Usuário",
      "type": "text",
      "default": "@seuperfil",
      "maxLength": 30
    },
    {
      "key": "useBrandColor",
      "label": "Usar cor da rede",
      "type": "toggle",
      "default": true
    },
    {
      "key": "position",
      "label": "Posição",
      "type": "select",
      "default": "bottom-left",
      "options": [
        {
          "value": "center",
          "label": "Centro"
        },
        {
          "value": "bottom-left",
          "label": "Inferior esquerda"
        },
        {
          "value": "bottom-right",
          "label": "Inferior direita"
        },
        {
          "value": "top-left",
          "label": "Superior esquerda"
        }
      ]
    },
    {
      "key": "font",
      "label": "Fonte",
      "type": "font",
      "default": "inter",
      "options": [
        {
          "value": "inter",
          "label": "Inter"
        },
        {
          "value": "montserrat",
          "label": "Montserrat"
        },
        {
          "value": "poppins",
          "label": "Poppins"
        },
        {
          "value": "bebas",
          "label": "Bebas Neue"
        },
        {
          "value": "playfair",
          "label": "Playfair Display"
        },
        {
          "value": "spacegrotesk",
          "label": "Space Grotesk"
        },
        {
          "value": "jetbrains",
          "label": "JetBrains Mono"
        }
      ]
    },
    {
      "key": "cardColor",
      "label": "Cor do cartão",
      "type": "color",
      "default": "#ffffff"
    },
    {
      "key": "textColor",
      "label": "Cor do texto",
      "type": "color",
      "default": "#111111"
    },
    {
      "key": "accentColor",
      "label": "Cor do ícone (se não usar cor da rede)",
      "type": "color",
      "default": "#ff3d5a"
    },
    {
      "key": "bgColor",
      "label": "Cor de fundo",
      "type": "color",
      "default": "#333333"
    },
    {
      "key": "transparent",
      "label": "Fundo transparente",
      "type": "toggle",
      "default": true,
      "help": "Exporte em MOV/WebM para manter a transparência"
    }
  ]
}
