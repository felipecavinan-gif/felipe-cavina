{
  "id": "3d-cubo-palavras",
  "name": "Cubo 3D de Palavras",
  "category": "Câmera 3D",
  "description": "As palavras trocam girando como faces de um cubo. Separe as palavras com |",
  "style": "flip-3d-words",
  "fps": 30,
  "durationInFrames": 120,
  "formats": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "fields": [
    {
      "key": "prefix",
      "label": "Texto fixo",
      "type": "text",
      "default": "Seja",
      "maxLength": 20
    },
    {
      "key": "words",
      "label": "Palavras que giram (separe com |)",
      "type": "textarea",
      "default": "CRIATIVO | RÁPIDO | ÚNICO"
    },
    {
      "key": "font",
      "label": "Fonte",
      "type": "font",
      "default": "montserrat",
      "options": [
        {
          "value": "inter",
          "label": "Inter"
        },
        {
          "value": "montserrat",
          "label": "Montserrat"
        },
        {
          "value": "poppins",
          "label": "Poppins"
        },
        {
          "value": "bebas",
          "label": "Bebas Neue"
        },
        {
          "value": "playfair",
          "label": "Playfair Display"
        },
        {
          "value": "spacegrotesk",
          "label": "Space Grotesk"
        },
        {
          "value": "jetbrains",
          "label": "JetBrains Mono"
        }
      ]
    },
    {
      "key": "fontSize",
      "label": "Tamanho",
      "type": "number",
      "default": 140,
      "min": 50,
      "max": 240,
      "step": 1
    },
    {
      "key": "textColor",
      "label": "Cor do texto fixo",
      "type": "color",
      "default": "#ffffff"
    },
    {
      "key": "wordColor",
      "label": "Cor das palavras",
      "type": "color",
      "default": "#0b0b0f"
    },
    {
      "key": "boxColor",
      "label": "Cor da caixa",
      "type": "color",
      "default": "#ffd400"
    },
    {
      "key": "stacked",
      "label": "Empilhar (vertical)",
      "type": "toggle",
      "default": false
    },
    {
      "key": "bgColor",
      "label": "Cor de fundo",
      "type": "color",
      "default": "#0b0b0f"
    },
    {
      "key": "transparent",
      "label": "Fundo transparente",
      "type": "toggle",
      "default": false
    }
  ],
  "props": {
    "uppercase": true
  }
}
