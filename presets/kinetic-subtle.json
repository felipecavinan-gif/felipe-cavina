{
  "id": "kinetic-subtle",
  "name": "Kinetic Suave",
  "category": "Tipografia animada",
  "description": "Versão leve, ideal para legendas de destaque.",
  "style": "kinetic-words",
  "fps": 30,
  "durationInFrames": 90,
  "formats": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "fields": [
    {
      "key": "text",
      "label": "Texto",
      "type": "textarea",
      "default": "menos é *mais*"
    },
    {
      "key": "font",
      "label": "Fonte",
      "type": "font",
      "default": "poppins",
      "options": [
        {
          "value": "inter",
          "label": "Inter"
        },
        {
          "value": "montserrat",
          "label": "Montserrat"
        },
        {
          "value": "poppins",
          "label": "Poppins"
        },
        {
          "value": "bebas",
          "label": "Bebas Neue"
        },
        {
          "value": "playfair",
          "label": "Playfair Display"
        },
        {
          "value": "spacegrotesk",
          "label": "Space Grotesk"
        },
        {
          "value": "jetbrains",
          "label": "JetBrains Mono"
        }
      ]
    },
    {
      "key": "textColor",
      "label": "Cor do texto",
      "type": "color",
      "default": "#ffffff"
    },
    {
      "key": "accentColor",
      "label": "Cor do destaque",
      "type": "color",
      "default": "#7cf5c4"
    },
    {
      "key": "fontSize",
      "label": "Tamanho",
      "type": "number",
      "default": 100,
      "min": 40,
      "max": 260,
      "step": 1
    },
    {
      "key": "wordDelay",
      "label": "Intervalo entre palavras (frames)",
      "type": "number",
      "default": 4,
      "min": 1,
      "max": 20,
      "step": 1
    },
    {
      "key": "uppercase",
      "label": "Caixa alta",
      "type": "toggle",
      "default": false
    },
    {
      "key": "bgColor",
      "label": "Cor de fundo",
      "type": "color",
      "default": "#000000"
    },
    {
      "key": "transparent",
      "label": "Fundo transparente",
      "type": "toggle",
      "default": true,
      "help": "Exporte em MOV/WebM para manter a transparência"
    }
  ],
  "props": {
    "accentBox": false
  }
}
