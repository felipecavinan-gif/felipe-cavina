      "type": "text",
      "default": "BLACK",
      "maxLength": 24
    },
    {
      "key": "line2",
      "label": "Linha 2",
      "type": "text",
      "default": "FRIDAY",
      "maxLength": 24
    },
    {
      "key": "line3",
      "label": "Linha 3 (menor, opcional)",
