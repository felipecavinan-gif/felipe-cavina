      "default": "montserrat",
      "options": [
        {
          "value": "inter",
          "label": "Inter"
        },
        {
          "value": "montserrat",
          "label": "Montserrat"
        },
        {
          "value": "poppins",
          "label": "Poppins"
        },
        {
          "value": "bebas",
          "label": "Bebas Neue"
        },
        {
          "value": "playfair",
          "label": "Playfair Display"
        },
        {
          "value": "spacegrotesk",
          "label": "Space Grotesk"
        },
        {
          "value": "jetbrains",
          "label": "JetBrains Mono"
        }
      ]
    },
    {
      "key": "fontSize",
      "label": "Tamanho",
      "type": "number",
      "default": 150,
      "min": 40,
      "max": 260,
      "step": 1
    },
    {
      "key": "textColor",
      "label": "Cor do texto",
      "type": "color",
      "default": "#ffffff"
