{
  "id": "3d-orbita",
  "name": "Órbita 3D",
  "category": "Câmera 3D",
  "description": "Título no centro com palavras orbitando em 3D, desfocadas quando passam por trás.",
  "style": "orbit-3d",
  "fps": 30,
  "durationInFrames": 150,
  "formats": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "fields": [
    {
      "key": "title",
      "label": "Título central",
      "type": "text",
      "default": "SUA MARCA",
      "maxLength": 24
    },
    {
      "key": "items",
      "label": "Palavras em órbita (separe com |)",
      "type": "textarea",
      "default": "Design | Vídeo | Social | Ads | Motion | Branding"
    },
    {
      "key": "font",
      "label": "Fonte",
      "type": "font",
      "default": "montserrat",
      "options": [
        {
          "value": "inter",
          "label": "Inter"
        },
        {
          "value": "montserrat",
          "label": "Montserrat"
        },
        {
          "value": "poppins",
          "label": "Poppins"
        },
        {
          "value": "bebas",
          "label": "Bebas Neue"
        },
        {
          "value": "playfair",
          "label": "Playfair Display"
        },
        {
          "value": "spacegrotesk",
          "label": "Space Grotesk"
        },
        {
          "value": "jetbrains",
          "label": "JetBrains Mono"
        }
      ]
    },
    {
      "key": "fontSize",
      "label": "Tamanho do título",
      "type": "number",
      "default": 120,
      "min": 50,
      "max": 220,
      "step": 1
    },
    {
      "key": "spinSpeed",
      "label": "Velocidade de giro (graus/s)",
      "type": "number",
      "default": 45,
      "min": 5,
      "max": 180,
      "step": 1
    },
    {
      "key": "tilt",
      "label": "Inclinação da órbita",
      "type": "number",
      "default": 14,
      "min": 0,
      "max": 40,
      "step": 1
    },
    {
      "key": "textColor",
      "label": "Cor do título",
      "type": "color",
      "default": "#ffffff"
    },
    {
      "key": "itemColor",
      "label": "Cor das palavras",
      "type": "color",
      "default": "#ffffff"
    },
    {
      "key": "accentColor",
      "label": "Cor alternada",
      "type": "color",
      "default": "#7cf5c4"
    },
    {
      "key": "bgColor",
      "label": "Cor de fundo",
      "type": "color",
      "default": "#0d0f1a"
    },
    {
      "key": "transparent",
      "label": "Fundo transparente",
      "type": "toggle",
      "default": false
    }
  ],
  "props": {
    "uppercase": true
  }
}
