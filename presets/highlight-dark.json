{
  "id": "highlight-dark",
  "name": "Destaque Neon",
  "category": "Tipografia animada",
  "description": "Marcação neon em fundo escuro.",
  "style": "highlight",
  "fps": 30,
  "durationInFrames": 100,
  "formats": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "fields": [
    {
      "key": "before",
      "label": "Texto antes",
      "type": "text",
      "default": "Pare de"
    },
    {
      "key": "highlight",
      "label": "Palavra destacada",
      "type": "text",
      "default": "procrastinar"
    },
    {
      "key": "after",
      "label": "Texto depois",
      "type": "text",
      "default": "hoje."
    },
    {
      "key": "font",
      "label": "Fonte",
      "type": "font",
      "default": "montserrat",
      "options": [
        {
          "value": "inter",
          "label": "Inter"
        },
        {
          "value": "montserrat",
          "label": "Montserrat"
        },
        {
          "value": "poppins",
          "label": "Poppins"
        },
        {
          "value": "bebas",
          "label": "Bebas Neue"
        },
        {
          "value": "playfair",
          "label": "Playfair Display"
        },
        {
          "value": "spacegrotesk",
          "label": "Space Grotesk"
        },
        {
          "value": "jetbrains",
          "label": "JetBrains Mono"
        }
      ]
    },
    {
      "key": "fontSize",
      "label": "Tamanho",
      "type": "number",
      "default": 100,
      "min": 40,
      "max": 200,
      "step": 1
    },
    {
      "key": "markStyle",
      "label": "Tipo de marcação",
      "type": "select",
      "default": "underline",
      "options": [
        {
          "value": "full",
          "label": "Marca-texto"
        },
        {
          "value": "underline",
          "label": "Sublinhado grosso"
        }
      ]
    },
    {
      "key": "textColor",
      "label": "Cor do texto",
      "type": "color",
      "default": "#ffffff"
    },
    {
      "key": "highlightTextColor",
      "label": "Cor da palavra destacada",
      "type": "color",
      "default": "#ffffff"
    },
    {
      "key": "accentColor",
      "label": "Cor do marca-texto",
      "type": "color",
      "default": "#ff2bd6"
    },
    {
      "key": "bgColor",
      "label": "Cor de fundo",
      "type": "color",
      "default": "#0b0b0f"
    },
    {
      "key": "transparent",
      "label": "Fundo transparente",
      "type": "toggle",
      "default": false,
      "help": "Exporte em MOV/WebM para manter a transparência"
    }
  ]
}
