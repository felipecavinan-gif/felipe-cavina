{
  "id": "contorno-oferta",
  "name": "Contorno Oferta",
  "category": "Contorno + flick",
  "description": "Promoção: duas palavras circuladas e uma chuva de flashes amarelos.",
  "style": "outline-flick",
  "fps": 30,
  "durationInFrames": 100,
  "formats": [
    "9:16",
    "16:9",
    "1:1",
    "4:5"
  ],
  "fields": [
    {
      "key": "text",
      "label": "Texto (a *palavra* entre asteriscos recebe o contorno)",
      "type": "textarea",
      "default": "*50%* off só *hoje*"
    },
    {
      "key": "font",
      "label": "Fonte",
      "type": "font",
      "default": "montserrat",
      "options": [
        {
          "value": "inter",
          "label": "Inter"
        },
        {
          "value": "montserrat",
          "label": "Montserrat"
        },
        {
          "value": "poppins",
          "label": "Poppins"
        },
        {
          "value": "bebas",
          "label": "Bebas Neue"
        },
        {
          "value": "playfair",
          "label": "Playfair Display"
        },
        {
          "value": "spacegrotesk",
          "label": "Space Grotesk"
        },
        {
          "value": "jetbrains",
          "label": "JetBrains Mono"
        }
      ]
    },
    {
      "key": "fontSize",
      "label": "Tamanho do texto",
      "type": "number",
      "default": 150,
      "min": 50,
      "max": 260,
      "step": 1
    },
    {
      "key": "outlineShape",
      "label": "Forma do contorno",
      "type": "select",
      "default": "ellipse",
      "options": [
        {
          "value": "ellipse",
          "label": "Círculo à mão"
        },
        {
          "value": "double",
          "label": "Círculo duplo"
        },
        {
          "value": "box",
          "label": "Caixa"
        },
        {
          "value": "underline",
          "label": "Sublinhado à mão"
        },
        {
          "value": "brackets",
          "label": "Colchetes"
        }
      ]
    },
    {
      "key": "outlineWidth",
      "label": "Espessura do contorno",
      "type": "number",
      "default": 10,
      "min": 2,
      "max": 20,
      "step": 1
    },
    {
      "key": "outlineAt",
      "label": "Início do contorno (0 a 1 do vídeo)",
      "type": "number",
      "default": 0.3,
      "min": 0.05,
      "max": 0.8,
      "step": 0.01
    },
    {
      "key": "outlineFrames",
      "label": "Duração do desenho do contorno (frames)",
      "type": "number",
      "default": 16,
      "min": 6,
      "max": 40,
      "step": 1
    },
    {
      "key": "scaleFrom",
      "label": "Escala inicial",
      "type": "number",
      "default": 1.7,
      "min": 1,
      "max": 3,
      "step": 0.05
    },
    {
      "key": "scaleTo",
      "label": "Escala final",
      "type": "number",
      "default": 0.92,
      "min": 0.5,
      "max": 1.5,
      "step": 0.01
    },
    {
      "key": "flickAt",
      "label": "Início dos flicks (0 a 1 do vídeo)",
      "type": "number",
      "default": 0.68,
      "min": 0.4,
      "max": 0.95,
      "step": 0.01
    },
    {
      "key": "flashAmount",
      "label": "Quantidade de flashes",
      "type": "number",
      "default": 0.55,
      "min": 0,
      "max": 0.9,
      "step": 0.05
    },
    {
      "key": "cinemaBlur",
      "label": "Blur de cinema (0 = desligado)",
      "type": "number",
      "default": 0,
      "min": 0,
      "max": 2,
      "step": 0.1
    },
    {
      "key": "invert",
      "label": "Inverter cores nos flicks",
      "type": "toggle",
      "default": true
    },
    {
      "key": "textColor",
      "label": "Cor do texto",
      "type": "color",
      "default": "#111111"
    },
    {
      "key": "keyColor",
      "label": "Cor da palavra contornada",
      "type": "color",
      "default": "#e8112d"
    },
    {
      "key": "outlineColor",
      "label": "Cor do contorno",
      "type": "color",
      "default": "#111111"
    },
    {
      "key": "flashColor",
      "label": "Cor do flash 1",
      "type": "color",
      "default": "#ffffff"
    },
    {
      "key": "accentColor",
      "label": "Cor do flash 2",
      "type": "color",
      "default": "#111111"
    },
    {
      "key": "bgColor",
      "label": "Cor de fundo",
      "type": "color",
      "default": "#ffd400"
    },
    {
      "key": "transparent",
      "label": "Fundo transparente",
      "type": "toggle",
      "default": false
    }
  ],
  "props": {
    "uppercase": true,
    "weight": 900
  }
}
