{
  "id": "impacto-manga-produto",
  "name": "Impacto Mangá com Produto",
  "category": "Impacto",
  "description": "O produto aparece com soco no centro das linhas de velocidade.",
  "style": "impact-frame",
  "fps": 30,
  "durationInFrames": 70,
  "formats": [
    "9:16",
    "16:9",
    "1:1",
    "4:5"
  ],
  "fields": [
    {
      "key": "image",
      "label": "Imagem (produto ou elemento)",
      "type": "image",
      "default": "builtin:perfume"
    },
    {
      "key": "title",
      "label": "Texto",
      "type": "text",
      "default": "NOVIDADE!",
      "maxLength": 16
    },
    {
      "key": "font",
      "label": "Fonte",
      "type": "font",
      "default": "bebas",
      "options": [
        {
          "value": "inter",
          "label": "Inter"
        },
        {
          "value": "montserrat",
          "label": "Montserrat"
        },
        {
          "value": "poppins",
          "label": "Poppins"
        },
        {
          "value": "bebas",
          "label": "Bebas Neue"
        },
        {
          "value": "playfair",
          "label": "Playfair Display"
        },
        {
          "value": "spacegrotesk",
          "label": "Space Grotesk"
        },
        {
          "value": "jetbrains",
          "label": "JetBrains Mono"
        }
      ]
    },
    {
      "key": "fontSize",
      "label": "Tamanho",
      "type": "number",
      "default": 220,
      "min": 60,
      "max": 320,
      "step": 1
    },
    {
      "key": "lineCount",
      "label": "Quantidade de linhas",
      "type": "number",
      "default": 70,
      "min": 20,
      "max": 140,
      "step": 1
    },
    {
      "key": "shake",
      "label": "Tremor",
      "type": "number",
      "default": 18,
      "min": 0,
      "max": 80,
      "step": 1
    },
    {
      "key": "tilt",
      "label": "Inclinação do texto",
      "type": "number",
      "default": -4,
      "min": -30,
      "max": 30,
      "step": 1
    },
    {
      "key": "invert",
      "label": "Frames invertidos",
      "type": "toggle",
      "default": true
    },
    {
      "key": "textColor",
      "label": "Cor do texto",
      "type": "color",
      "default": "#ffffff"
    },
    {
      "key": "accentColor",
      "label": "Cor da sombra do texto",
      "type": "color",
      "default": "#ff3d00"
    },
    {
      "key": "lineColor",
      "label": "Cor das linhas",
      "type": "color",
      "default": "#ffffff"
    },
    {
      "key": "bgColor",
      "label": "Cor de fundo",
      "type": "color",
      "default": "#ff3d00"
    },
    {
      "key": "transparent",
      "label": "Fundo transparente",
      "type": "toggle",
      "default": false
    }
  ],
  "props": {
    "showImage": true,
    "innerRadius": 0.36
  }
}
