{
  "id": "cta-follow-dark",
  "name": "Botão Seguir (dark)",
  "category": "CTA / Redes sociais",
  "description": "Versão escura para Instagram/TikTok.",
  "style": "subscribe-cta",
  "fps": 30,
  "durationInFrames": 110,
  "formats": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "fields": [
    {
      "key": "channelName",
      "label": "Nome do perfil",
      "type": "text",
      "default": "@seuperfil",
      "maxLength": 24
    },
    {
      "key": "buttonText",
      "label": "Texto do botão",
      "type": "text",
      "default": "Seguir"
    },
    {
      "key": "doneText",
      "label": "Texto após clique",
      "type": "text",
      "default": "Seguindo"
    },
    {
      "key": "showBell",
      "label": "Mostrar sino",
      "type": "toggle",
      "default": false
    },
    {
      "key": "font",
      "label": "Fonte",
      "type": "font",
      "default": "inter",
      "options": [
        {
          "value": "inter",
          "label": "Inter"
        },
        {
          "value": "montserrat",
          "label": "Montserrat"
        },
        {
          "value": "poppins",
          "label": "Poppins"
        },
        {
          "value": "bebas",
          "label": "Bebas Neue"
        },
        {
          "value": "playfair",
          "label": "Playfair Display"
        },
        {
          "value": "spacegrotesk",
          "label": "Space Grotesk"
        },
        {
          "value": "jetbrains",
          "label": "JetBrains Mono"
        }
      ]
    },
    {
      "key": "cardColor",
      "label": "Cor do cartão",
      "type": "color",
      "default": "#161616"
    },
    {
      "key": "textColor",
      "label": "Cor do texto",
      "type": "color",
      "default": "#ffffff"
    },
    {
      "key": "accentColor",
      "label": "Cor do botão",
      "type": "color",
      "default": "#0095f6"
    },
    {
      "key": "bgColor",
      "label": "Cor de fundo",
      "type": "color",
      "default": "#00ff00"
    },
    {
      "key": "transparent",
      "label": "Fundo transparente",
      "type": "toggle",
      "default": true,
      "help": "Exporte em MOV/WebM para manter a transparência"
    }
  ]
}
