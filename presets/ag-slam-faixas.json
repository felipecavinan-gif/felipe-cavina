{
  "id": "ag-slam-faixas",
  "name": "Slam com Faixas",
  "category": "Motion agressivo",
  "description": "Frase sendo montada a marteladas sobre faixas diagonais em movimento.",
  "style": "slam-impact",
  "fps": 30,
  "durationInFrames": 110,
  "formats": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "fields": [
    {
      "key": "text",
      "label": "Texto (use *palavra* para destacar)",
      "type": "textarea",
      "default": "O *MAIOR* EVENTO DO ANO"
    },
    {
      "key": "font",
      "label": "Fonte",
      "type": "font",
      "default": "bebas",
      "options": [
        {
          "value": "inter",
          "label": "Inter"
        },
        {
          "value": "montserrat",
          "label": "Montserrat"
        },
        {
          "value": "poppins",
          "label": "Poppins"
        },
        {
          "value": "bebas",
          "label": "Bebas Neue"
        },
        {
          "value": "playfair",
          "label": "Playfair Display"
        },
        {
          "value": "spacegrotesk",
          "label": "Space Grotesk"
        },
        {
          "value": "jetbrains",
          "label": "JetBrains Mono"
        }
      ]
    },
    {
      "key": "fontSize",
      "label": "Tamanho",
      "type": "number",
      "default": 230,
      "min": 80,
      "max": 340,
      "step": 1
    },
    {
      "key": "beat",
      "label": "Frames entre batidas",
      "type": "number",
      "default": 7,
      "min": 3,
      "max": 30,
      "step": 1
    },
    {
      "key": "shake",
      "label": "Força do tremor",
      "type": "number",
      "default": 34,
      "min": 0,
      "max": 80,
      "step": 1
    },
    {
      "key": "flash",
      "label": "Flash a cada batida",
      "type": "toggle",
      "default": false
    },
    {
      "key": "textColor",
      "label": "Cor do texto",
      "type": "color",
      "default": "#111111"
    },
    {
      "key": "accentColor",
      "label": "Cor do destaque",
      "type": "color",
      "default": "#ffffff"
    },
    {
      "key": "shadowColor",
      "label": "Cor da sombra",
      "type": "color",
      "default": "#ff3d00"
    },
    {
      "key": "stripeColor",
      "label": "Cor das faixas",
      "type": "color",
      "default": "#ffb800"
    },
    {
      "key": "bgColor",
      "label": "Cor de fundo",
      "type": "color",
      "default": "#ffd400"
    },
    {
      "key": "stripeSpeed",
      "label": "Velocidade das faixas",
      "type": "number",
      "default": 6,
      "min": 0,
      "max": 30,
      "step": 1
    }
  ],
  "props": {
    "mode": "stack",
    "stripes": true,
    "shadow": true,
    "tiltWords": 0
  }
}
