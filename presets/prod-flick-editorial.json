      "label": "Deslocar imagem (vertical)",
      "type": "number",
      "default": 8,
      "min": -60,
      "max": 60,
      "step": 1
    },
    {
      "key": "textLayer",
      "label": "Texto em relação à imagem",
      "type": "select",
      "default": "back",
      "options": [
        {
          "value": "back",
          "label": "Atrás da imagem"
        },
        {
          "value": "front",
          "label": "Na frente da imagem"
        }
      ]
    },
    {
      "key": "flickSpeed",
      "label": "Velocidade do flick",
      "type": "number",
      "default": 1,
      "min": 0.5,
      "max": 3,
      "step": 0.1
    },
    {
      "key": "flash",
      "label": "Flash nos cortes",
      "type": "toggle",
      "default": false
    },
    {
      "key": "float",
      "label": "Imagem flutuando",
      "type": "toggle",
      "default": true
    },
    {
      "key": "textColor",
      "label": "Cor do texto",
      "type": "color",
      "default": "#111111"
    },
    {
      "key": "bgColor",
      "label": "Cor de fundo",
      "type": "color",
      "default": "#ffffff"
    },
    {
      "key": "transparent",
      "label": "Fundo transparente",
      "type": "toggle",
      "default": false
    }
