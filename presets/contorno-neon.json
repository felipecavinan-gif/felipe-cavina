{
  "id": "contorno-neon",
  "name": "Contorno Neon",
  "category": "Contorno + blur",
  "description": "Caixa neon desenhada em volta da palavra enquanto o texto encolhe devagar.",
  "style": "outline-flick",
  "fps": 30,
  "durationInFrames": 110,
  "formats": [
    "9:16",
    "16:9",
    "1:1",
    "4:5"
  ],
  "fields": [
    {
      "key": "text",
      "label": "Texto (a *palavra* entre asteriscos recebe o contorno)",
      "type": "textarea",
      "default": "ative o modo *turbo*"
    },
    {
      "key": "font",
      "label": "Fonte",
      "type": "font",
      "default": "spacegrotesk",
      "options": [
        {
          "value": "inter",
          "label": "Inter"
        },
        {
          "value": "montserrat",
          "label": "Montserrat"
        },
        {
          "value": "poppins",
          "label": "Poppins"
        },
        {
          "value": "bebas",
          "label": "Bebas Neue"
        },
        {
          "value": "playfair",
          "label": "Playfair Display"
        },
        {
          "value": "spacegrotesk",
          "label": "Space Grotesk"
        },
        {
          "value": "jetbrains",
          "label": "JetBrains Mono"
        }
      ]
    },
    {
      "key": "fontSize",
      "label": "Tamanho do texto",
      "type": "number",
      "default": 130,
      "min": 50,
      "max": 260,
      "step": 1
    },
    {
      "key": "outlineShape",
      "label": "Forma do contorno",
      "type": "select",
      "default": "box",
      "options": [
        {
          "value": "ellipse",
          "label": "Círculo à mão"
        },
        {
          "value": "double",
          "label": "Círculo duplo"
        },
        {
          "value": "box",
          "label": "Caixa"
        },
        {
          "value": "underline",
          "label": "Sublinhado à mão"
        },
        {
          "value": "brackets",
          "label": "Colchetes"
        }
      ]
    },
    {
      "key": "outlineWidth",
      "label": "Espessura do risco",
      "type": "number",
      "default": 3.5,
      "min": 1,
      "max": 12,
      "step": 0.5
    },
    {
      "key": "outlineBlur",
      "label": "Blur do risco",
      "type": "number",
      "default": 1.2,
      "min": 0,
      "max": 6,
      "step": 0.1
    },
    {
      "key": "outlineOpacity",
      "label": "Opacidade do risco",
      "type": "number",
      "default": 0.85,
      "min": 0.2,
      "max": 1,
      "step": 0.05
    },
    {
      "key": "outlineAt",
      "label": "Início do contorno (0 a 1 do vídeo)",
      "type": "number",
      "default": 0.32,
      "min": 0.05,
      "max": 0.8,
      "step": 0.01
    },
    {
      "key": "outlineFrames",
      "label": "Duração do risco (frames)",
      "type": "number",
      "default": 24,
      "min": 8,
      "max": 60,
      "step": 1
    },
    {
      "key": "scaleFrom",
      "label": "Escala na chegada (atravessando a tela)",
      "type": "number",
      "default": 3.2,
      "min": 1,
      "max": 6,
      "step": 0.1
    },
    {
      "key": "introFrames",
      "label": "Duração da chegada forte (frames)",
      "type": "number",
      "default": 24,
      "min": 6,
      "max": 60,
      "step": 1
    },
    {
      "key": "scaleTo",
      "label": "Escala final (diminuição sutil)",
      "type": "number",
      "default": 0.9,
      "min": 0.6,
      "max": 1.2,
      "step": 0.01
    },
    {
      "key": "outroFrames",
      "label": "Duração da saída em blur (frames)",
      "type": "number",
      "default": 16,
      "min": 6,
      "max": 40,
      "step": 1
    },
    {
      "key": "cinemaBlur",
      "label": "Blur de cinema (0 = desligado)",
      "type": "number",
      "default": 0,
      "min": 0,
      "max": 2,
      "step": 0.1
    },
    {
      "key": "textColor",
      "label": "Cor do texto",
      "type": "color",
      "default": "#ffffff"
    },
    {
      "key": "keyColor",
      "label": "Cor da palavra contornada",
      "type": "color",
      "default": "#00e5ff"
    },
    {
      "key": "outlineColor",
      "label": "Cor do contorno",
      "type": "color",
      "default": "#00e5ff"
    },
    {
      "key": "bgColor",
      "label": "Cor de fundo",
      "type": "color",
      "default": "#05060a"
    },
    {
      "key": "transparent",
      "label": "Fundo transparente",
      "type": "toggle",
      "default": false
    }
  ],
  "props": {
    "uppercase": true,
    "weight": 700
  }
}
