{
  "id": "cta-subscribe",
  "name": "Botão Inscreva-se",
  "category": "CTA / Redes sociais",
  "description": "Cursor clica em 'Inscrever-se' e o sino toca. Fundo transparente. Troque a foto pela do seu perfil.",
  "style": "subscribe-cta",
  "fps": 30,
  "durationInFrames": 110,
  "formats": [
    "16:9",
    "9:16",
    "1:1",
    "4:5"
  ],
  "fields": [
    {
      "key": "avatar",
      "label": "Foto do perfil (Instagram, YouTube…)",
      "type": "image",
      "default": "builtin:avatar",
      "allowEmpty": true,
      "options": [
        {
          "value": "builtin:avatar",
          "label": "Exemplo"
        }
      ]
    },
    {
      "key": "channelName",
      "label": "Nome do canal",
      "type": "text",
      "default": "Meu Canal",
      "maxLength": 24
    },
    {
      "key": "buttonText",
      "label": "Texto do botão",
      "type": "text",
      "default": "Inscrever-se"
    },
    {
      "key": "doneText",
      "label": "Texto após clique",
      "type": "text",
      "default": "Inscrito"
    },
    {
      "key": "showBell",
      "label": "Mostrar sino",
      "type": "toggle",
      "default": true
    },
    {
      "key": "font",
      "label": "Fonte",
      "type": "font",
      "default": "poppins",
      "options": [
        {
          "value": "inter",
          "label": "Inter"
        },
        {
          "value": "montserrat",
          "label": "Montserrat"
        },
        {
          "value": "poppins",
          "label": "Poppins"
        },
        {
          "value": "bebas",
          "label": "Bebas Neue"
        },
        {
          "value": "playfair",
          "label": "Playfair Display"
        },
        {
          "value": "spacegrotesk",
          "label": "Space Grotesk"
        },
        {
          "value": "jetbrains",
          "label": "JetBrains Mono"
        }
      ]
    },
    {
      "key": "cardColor",
      "label": "Cor do cartão",
      "type": "color",
      "default": "#ffffff"
    },
    {
      "key": "textColor",
      "label": "Cor do texto",
      "type": "color",
      "default": "#111111"
    },
    {
      "key": "accentColor",
      "label": "Cor do botão",
      "type": "color",
      "default": "#ff0033"
    },
    {
      "key": "bgColor",
      "label": "Cor de fundo",
      "type": "color",
      "default": "#00ff00"
    },
    {
      "key": "transparent",
      "label": "Fundo transparente",
      "type": "toggle",
      "default": true,
      "help": "Exporte em MOV/WebM para manter a transparência"
    }
  ]
}
