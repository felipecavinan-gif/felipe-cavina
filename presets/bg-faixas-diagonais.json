    {
      "key": "color1",
      "label": "Cor 1",
      "type": "color",
      "default": "#ff3d5a"
    },
    {
      "key": "color2",
      "label": "Cor 2",
      "type": "color",
      "default": "#ffd400"
    },
    {
      "key": "color3",
      "label": "Cor 3",
      "type": "color",
      "default": "#111111"
    },
    {
      "key": "bgColor",
      "label": "Cor de fundo",
      "type": "color",
      "default": "#ffffff"
